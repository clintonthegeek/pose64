diff --git a/src/mcp_server.cpp b/src/mcp_server.cpp
index a259b8a..4467646 100644
--- a/src/mcp_server.cpp
+++ b/src/mcp_server.cpp
@@ -71,6 +71,20 @@ bool server::start(bool blocking) {
         this->handle_sse(req, res);
         LOG_INFO(req.remote_addr, ":", req.remote_port, " - \"GET ", req.path, " HTTP/1.1\" ", res.status);
     });
+
+    // MCP 2025-06-18 OAuth discovery: signal that no auth is required.
+    // Claude Code probes this path before connecting; a 404 makes it
+    // think auth failed.  Return a minimal "no auth" response instead.
+    // Catch-all for any GET/POST not handled above — log what was
+    // requested and return a JSON 404 so Claude Code doesn't choke
+    // on an empty body.
+    http_server_->set_error_handler([](const httplib::Request& req, httplib::Response& res) {
+        LOG_WARNING("Unhandled ", req.method, " ", req.path, " -> ", res.status);
+        if (res.body.empty()) {
+            res.set_header("Content-Type", "application/json");
+            res.body = R"({"error":"not_found"})";
+        }
+    });
     
     // Start resource check thread (only start in non-blocking mode)
     if (!blocking) {
@@ -754,14 +768,18 @@ json server::handle_initialize(const request& req, const std::string& session_id
     std::string requested_version = params["protocolVersion"].get<std::string>();
     LOG_INFO("Client requested protocol version: ", requested_version);
 
-    if (requested_version != MCP_VERSION) {
+    // Accept both the 2024-11-05 (SSE) and 2025-06-18 (Streamable HTTP) protocol
+    // versions.  We always respond with MCP_VERSION ("2024-11-05") which is the
+    // version we actually implement; the spec says the client must accept the
+    // server's choice.
+    if (requested_version != MCP_VERSION && requested_version != "2025-06-18") {
         LOG_ERROR("Unsupported protocol version: ", requested_version, ", server supports: ", MCP_VERSION);
         return response::create_error(
