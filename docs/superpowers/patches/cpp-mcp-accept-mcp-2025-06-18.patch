-            error_code::invalid_params, 
+            req.id,
+            error_code::invalid_params,
             "Unsupported protocol version",
             {
-                {"supported", {MCP_VERSION}},
+                {"supported", {MCP_VERSION, "2025-06-18"}},
                 {"requested", params["protocolVersion"]}
             }
         ).to_json();
